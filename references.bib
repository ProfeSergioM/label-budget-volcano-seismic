@article{cui_subdivision_2021,
	title = {Subdivision of {Seismicity} {Beneath} the {Summit} {Region} of {Kilauea} {Volcano}: {Implications} for the {Preparation} {Process} of the 2018 {Eruption}},
	volume = {48},
	doi = {10.1029/2021GL094698},
	abstract = {Long-period (LP), hybrid, and volcano-tectonic (VT) seismicity are important indicators for tracking the evolution of volcanic processes. Here, we propose an unsupervised learning method to classify 5,949 seismic events in Kilauea volcano, Hawai'i, during a 4-month period before the collapse of Pu'u’ O'o on April 30, 2018. The LPs and hybrids exhibit three major episodes, which progressively intensified and had increasing shallow events toward the eruption. The most intense episode starting 3 weeks before eruption coincides with changes in near-caldera deformation and lava lake elevation in Halema'uma'u, serving as possible immediate precursors. However, the first two episodes imply magma migration was already active months prior to the eruption. The spatiotemporal patterns of abundant hybrids reveal that they are associated with magma movement but mixed with shear-failure or near-surface resonance. Our results provide useful constraints on the magmatic processes in the preparation phase of the Kilauea eruption in 2018. © 2021. American Geophysical Union. All Rights Reserved.},
	number = {20},
	journal = {Geophysical Research Letters},
	author = {Cui, X. and Li, Z. and Huang, H.},
	year = {2021},
	keywords = {Hawai'i, Hawaii [(ISL) Hawaiian Islands], Hawaii [United States], Hawaiian Islands, Kilauea, Kilauea volcano, Preparation process, Seismic event, Unsupervised learning, Unsupervised learning method, Volcanic process, Volcanic seismicity, Volcanics, Volcano monitoring, Volcano-tectonic seismicities, Volcanoes, collapse, lava, machine learning, magma, seismic migration, seismicity, volcanic eruption, volcanic seismicity, volcano monitoring},
}

